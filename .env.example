# Токен бота из https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=
# ID канала, куда писать (Discord: режим разработчика → ПКМ по каналу → Копировать ID)
DISCORD_CHANNEL_ID=

# Ключ из https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Модели через запятую: если первая упала — пробуется следующая. Список: https://openrouter.ai/models
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free,google/gemma-4-26b-a4b-it:free

# Стиль комментариев:
#   random                — каждый раз случайный из готовых
#   caster                — один готовый: caster, gopnik, shakespeare, pirate, noir, grandma,
#                           toxic, philosopher, rap, news, nature, medieval, corporate
#   pirate,noir,grandma   — случайный из перечисленных
#   любой свой текст      — например: Как будто Гордон Рамзи оценивает блюдо
STYLE=random
# Максимальная длина разбора в символах; длинный текст бот разобьёт на несколько сообщений
MAX_CHARS=5000
# Креативность модели: 0.0 — скучно и точно, 1.0–1.3 — смешнее, но может нести чушь
TEMPERATURE=1.0

# Игроки: ник:имя:id через запятую. id — число из ссылки dotabuff.com/players/<id>
PLAYERS=Dendi:Даня:70388657,Puppey:Клим:87278757

# Над кем бот шутит всегда (имена из PLAYERS через запятую)
ROAST_TARGET=Клим
# Как часто бот шутит про случайного игрока из PLAYERS, в часах (0 — не шутить)
JOKE_INTERVAL_HOURS=3

# Как часто проверять новые матчи, в минутах
INTERVAL_MIN=5

# Необязательно: ключ OpenDota (без него лимит ~2000 запросов в день, для пары друзей хватает)
# OPENDOTA_API_KEY=
# Необязательно: токен STRATZ для /test-live (бесплатно на stratz.com/api после входа через Steam)
# STRATZ_TOKEN=
# Необязательно: где хранить состояние (какие матчи уже прокомментированы)
# STATE_FILE=./data/state.json
